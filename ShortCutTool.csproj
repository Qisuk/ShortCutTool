<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Application Metadata -->
    <AssemblyName>ShortCutTool</AssemblyName>
    <Product>ShortCut Tool</Product>
    <Copyright>Copyright © 2026</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.3</Version>
    <Description>Keyboard shortcut manager with Meh/Hyper key support for launching and cycling through application windows</Description>
    <Authors>ChrisMoir</Authors>
    <RepositoryUrl>https://github.com/Qisuk/ShortCutTool</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Qisuk/ShortCutTool</PackageProjectUrl>
    <PackageReadmeFile>Documents\README.md</PackageReadmeFile>

    <!-- Application Icon -->
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\Icons\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include=".github\workflows\publish.yml" />
  </ItemGroup>

</Project>
